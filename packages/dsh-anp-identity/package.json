{
  "name": "@agent-network-protocol/dsh-anp-identity",
  "version": "0.1.0",
  "description": "ANP Identity management plugin for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./provider": {
      "types": "./lib/provider.d.ts",
      "default": "./lib/provider.js"
    },
    "./provider-api": {
      "types": "./lib/provider-api.d.ts",
      "default": "./lib/provider-api.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "BOUNDARY.md",
    "examples/**",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && vitest run",
    "update:public": "node scripts/public-snapshot.mjs --update",
    "check:public": "npm run build && node scripts/public-snapshot.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "verify": "npm run typecheck && npm run check:public && npm run check:generated && npm test",
    "prepack": "npm run verify"
  },
  "keywords": [
    "anp",
    "did",
    "identity",
    "deepseek-harness",
    "dsh-plugin"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgentNetworkProtocol/anp-identity.git",
    "directory": "packages/dsh-anp-identity"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "peerDependencies": {
    "@agent-network-protocol/anp-identity": "^0.2.0",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@agent-network-protocol/anp-identity": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
