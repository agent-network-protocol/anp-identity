{
  "name": "@agent-network-protocol/anp-identity",
  "version": "0.2.0",
  "description": "Secure E1 DID identity custody and lifecycle management for ANP",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./provider": {
      "types": "./provider.d.ts",
      "require": "./provider.js",
      "default": "./provider.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "provider.js",
    "provider.d.ts",
    "native.cjs",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "SOURCE.md",
    "checksums.json",
    "provenance.json",
    "sbom.cdx.json"
  ],
  "scripts": {
    "build": "napi build --platform --release && node scripts/wrap.mjs",
    "build:debug": "napi build --platform && node scripts/wrap.mjs",
    "build:all": "napi build --release && node scripts/wrap.mjs",
    "test": "node scripts/wrap.mjs && node --test test/*.test.cjs && node scripts/check-dts.mjs"
  },
  "napi": {
    "binaryName": "anp-identity",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "optionalDependencies": {
    "@agent-network-protocol/anp-identity-darwin-arm64": "0.2.0",
    "@agent-network-protocol/anp-identity-darwin-x64": "0.2.0",
    "@agent-network-protocol/anp-identity-linux-arm64-gnu": "0.2.0",
    "@agent-network-protocol/anp-identity-linux-x64-gnu": "0.2.0",
    "@agent-network-protocol/anp-identity-win32-x64-msvc": "0.2.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.8.6",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
